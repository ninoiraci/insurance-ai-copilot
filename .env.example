# ---------------------------------------------------------------------------
# Insurance Conversation Intelligence — AI Case Copilot
#
# Copy to .env and adjust:      cp .env.example .env
#
# EVERY value here is optional. With no .env at all the project still runs:
# SQLite for storage and DEMO MODE for the AI, both clearly labelled in the UI.
# Never commit a real .env — it is in .gitignore.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Omit entirely to use the zero-setup SQLite fallback at backend/instance/.
# Docker Compose sets this automatically to the pgvector container.
# DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot
POSTGRES_PORT=5432

# --- Application -----------------------------------------------------------
FLASK_ENV=development
SECRET_KEY=change-me-in-any-real-deployment
LOG_LEVEL=INFO
BACKEND_PORT=5001
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM provider ----------------------------------------------------------
# Leave LLM_API_KEY empty to run in DEMO MODE: a deterministic mock rule engine
# produces the same JSON contract a model would. The UI labels it "Demo AI Mode"
# and every stored analysis is flagged demo_mode=true. It is never passed off
# as real model output.
#
# Supported providers: anthropic | openai
LLM_PROVIDER=
LLM_API_KEY=
# Defaults per provider: anthropic → claude-sonnet-4-20250514, openai → gpt-4o-mini
LLM_MODEL=
# Optional: an OpenAI-compatible gateway or proxy.
LLM_BASE_URL=
# Low temperature for analytical work: the classifier must be reproducible.
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SECONDS=45
# Retries on malformed / schema-invalid output before the safe fallback kicks in.
LLM_MAX_RETRIES=2
# Exponential backoff between *transport* retries (rate limits, 5xx). Schema
# failures retry immediately: waiting does not make a model emit valid JSON.
LLM_RETRY_BACKOFF_SECONDS=0.5

# Force demo mode even when a key is present (useful for offline demos and CI).
AI_DEMO_MODE=false

# --- Embeddings ------------------------------------------------------------
# hashing → offline, deterministic, LEXICAL (no API key needed)
# openai  → real semantic embeddings (needs EMBEDDING_API_KEY or an OpenAI LLM key)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# IMPORTANT: this fixes the pgvector column width at migration time.
# hashing → 384, openai text-embedding-3-small → 1536.
# Changing it requires a new migration plus a full re-ingest.
EMBEDDING_DIMENSIONS=384

# --- RAG -------------------------------------------------------------------
RAG_TOP_K=5
# Similarity floor. Chunks below it are discarded, so "no relevant sources" is a
# real outcome and generation refuses instead of answering ungrounded.
# Calibrated for the hashing embedder; re-tune when switching provider.
RAG_MIN_SIMILARITY=0.16
RAG_CHUNK_TARGET_CHARS=900
RAG_CHUNK_OVERLAP_CHARS=150

# --- Reliability thresholds ------------------------------------------------
# Below this confidence a draft always goes to a human.
AI_CONFIDENCE_THRESHOLD=0.75

# --- Data locations --------------------------------------------------------
# Defaults resolve relative to the repository root; override for Docker.
# KNOWLEDGE_BASE_DIR=./data/knowledge_base

# --- Observability ---------------------------------------------------------
# Off by default: message bodies are customer content and stay out of logs.
LOG_MESSAGE_BODIES=false
